# Required for real upload.
export NOTION_TOKEN="secret_xxx"

# Preferred: create pages under an existing Notion page.
export NOTION_PARENT_PAGE_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Alternative: create pages under a Notion data source/database.
# export NOTION_DATA_SOURCE_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# export NOTION_TITLE_PROPERTY="Name"

# Keep aligned with current Notion docs unless you intentionally pin older API behavior.
export NOTION_VERSION="2026-03-11"

# Catalog uploader property names. Change these only if your data source uses different names.
export NOTION_TITLE_PROPERTY="이름"
export NOTION_BOOK_PROPERTY="책 제목"
export NOTION_PREVIOUS_PROPERTY="이전 (소)챕터"
export NOTION_NEXT_PROPERTY="이후 (소)챕터"
export NOTION_CHAPTER_PROPERTY="챕터"
